# Copie este arquivo para .env na raiz do repositório:
#   Windows: Copy-Item .env.example .env
#   Linux:   cp .env.example .env
#
# O .env fica fora do Git. Troque todos os valores marcados como SEGREDO
# antes de expor a stack fora da sua máquina. Não commite senhas, chaves
# nem tokens reais.

# --- Banco e cache (Docker Compose) ---
# Dentro da rede Docker os hostnames são postgres e redis.
POSTGRES_USER=vitrio
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
POSTGRES_DB=vitrio
DATABASE_URL=postgresql+asyncpg://vitrio:troque-esta-senha-do-postgres@postgres:5432/vitrio
REDIS_URL=redis://redis:6379/0

# --- Segredos da aplicação (SEGREDO) ---
# Gere cada um com pelo menos 32 bytes aleatórios.
# Windows: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Linux:   openssl rand -base64 48
JWT_SECRET=troque-este-segredo-jwt
STORAGE_SECRET=troque-este-segredo-storage
REVALIDATE_SECRET=troque-este-segredo-revalidate
INTEGRATIONS_KEY=troque-esta-chave-de-integracoes

# --- Domínio e cookies ---
BASE_DOMAIN=localhost
HTTP_PORT=8080
COOKIE_SECURE=false

# --- Loja demo criada no seed ---
# Credenciais só para desenvolvimento local.
DEMO_OWNER_EMAIL=owner@example.com
DEMO_OWNER_PASSWORD=troque-esta-senha-demo
DEMO_OWNER_NAME=Maria Demo
